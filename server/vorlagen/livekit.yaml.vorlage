port: 7880
log_level: info
rtc:
  tcp_port: 7881
  udp_port: 7882
  use_external_ip: false
  node_ip: @@OEFFENTLICHE_IP@@
keys:
  @@LIVEKIT_KEY@@: @@LIVEKIT_SECRET@@
room:
  # Räume legt nur die Zentrale an (Kursstart/Eintritt) und löscht sie bei Pause und Ende
  auto_create: false
  empty_timeout: 300
  max_participants: 50
